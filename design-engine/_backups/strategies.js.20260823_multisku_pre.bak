", "dims": [["Number", "60+ countries; 1 billion+ sold worldwide*; 100+ years; 12h protection; 9 herbs; 4,000 units in AU"], ["Layout", "giant figure dominating; number + one line; badge cluster"], ["Visual", "oversized numeral; world map; product small; icon"], ["Colour / mood", "bold impact; navy authority; premium"], ["Copy", "one big claim; '*based on internal data'; 'the numbers speak'"]]}, {"id": "milestone-community-thank-you", "name": "Milestone / Community Thank-You", "cat": "Community", "product": "none", "dims": [["Occasion", "welcome to Australia; follower milestone; thank-you; new-range launch; community shout-out"], ["Layout", "big thank-you type; milestone badge; confetti; smile grid"], ["Visual", "confetti; heart; number badge; community smiles; no product"], ["Colour / mood", "celebratory warm; bright; brand"], ["Branding", "LACALUT logo; 'thank you' hero; wordmark footer"]]}, {"id": "history-evolution", "name": "History / Evolution", "cat": "Educational", "product": "none", "dims": [["Topic", "what people used before toothbrushes (twigs, chew sticks, salt, charcoal); what people used before toothpaste (chalk, charcoal, dental powder); LACALUT's 1925 origin — began as a dental POWDER, later became paste; evolution of the toothbrush timeline; oral care through the ages; German dental innovation over 100 years"], ["Layout", "left-to-right timeline; then-vs-now split; Apple-style clean evolution lineup; museum-card row"], ["Visual", "artefact illustrations; timeline arrows; minimalist evolution row; vintage-to-modern fade"], ["Colour / mood", "clean editorial; museum neutral; navy heritage; modern minimalist"], ["Copy / branding", "'How we used to clean our teeth'; 'The evolution of oral care'; LACALUT logo only, no product"]]}, {"id": "b2b-partner-trade", "name": "B2B Partner / Trade (LinkedIn)", "cat": "B2B", "product": "optional", "dims": [["Angle", "new pharmacies & dental practices stocking LACALUT every week; our free in-practice sampling program